+def _norm_befehl(text: str) -> str:
+    """Für den Ablage-Abgleich: \\ → /, klein, Quoting entfernt, ${env:x} → $env:x, "/./" und "//" zusammengefasst."""
+    n = re.sub(r"[\"'`]", "", _norm_pfad(text))
+    n = re.sub(r"\$\{env:([a-z_]+)\}", r"$env:\1", n)
+    while "/./" in n:
+        n = n.replace("/./", "/")
+    return re.sub(r"(?<!:)//+", "/", n)
+
